#!/usr/bin/env python3
"""Stand-in for dnscrypt-proxy (used via DNSCRYPT_ROUTES_TEST_BINARY).

STUB_MODE: ok | no-live | crash | check-fail.  STUB_PIDFILE / STUB_TRACE record what happened.
"""
import os
import re
import sys
import time

mode = os.environ.get("STUB_MODE", "ok")
args = sys.argv[1:]
trace = os.environ.get("STUB_TRACE")


def note(word):
    if trace:
        with open(trace, "a") as handle:
            handle.write(word + "\n")


if "-check" in args:
    note("check")
    if mode == "check-fail":
        print("[FATAL] invalid configuration: boom")
        sys.exit(2)
    cfg = open(args[args.index("-config") + 1]).read()
    listed = re.search(r"blocked_names_file = '([^']+)'", cfg)
    if listed and not os.path.exists(listed.group(1)):
        print("[FATAL] open %s: no such file or directory" % listed.group(1))
        sys.exit(2)
    print("configuration OK")
    sys.exit(0)

note("start")
if os.environ.get("STUB_PIDFILE"):
    with open(os.environ["STUB_PIDFILE"], "w") as handle:
        handle.write(str(os.getpid()))
if mode == "crash":
    print("[FATAL] listen udp 127.0.0.1:5354: bind: address already in use")
    sys.stdout.flush()
    sys.exit(1)
if mode == "crash-plain":  # output lines without a level: the stdout fallback of the failure note
    print("plain line one\nplain line two\nplain line three")
    sys.stdout.flush()
    sys.exit(1)
if mode == "no-live":
    print("[ERROR] stub: still starting, no server answered yet")
    sys.stdout.flush()
config = open(args[args.index("-config") + 1]).read()
log = re.search(r"^log_file = '([^']+)'", config, re.M).group(1)
P = "[2026-10-12 10:00:0%d] [NOTICE] "
lines = [
    "Anonymizing queries for [good-dnscrypt] via [anon-relay-a]",
    "Anonymizing queries for [good-dnscrypt] via [anon-relay-b]",
    "[good-dnscrypt] OK (DNSCrypt) - rtt: 41ms",
]
if mode == "ok":
    lines += [
        "[doh-one] OK (DoH) - rtt: 20ms",
        "[direct-one] OK (DNSCrypt) - rtt: 30ms",
        "[slow-one] TIMEOUT",
        "Sorted latencies:",
        "Server with the lowest initial latency: direct-one (rtt: 30ms), live servers: 3",
    ]
with open(log, "a") as handle:
    for number, line in enumerate(lines):
        handle.write((P % (number % 10)) + line + "\n")
sys.stdout.flush()
while True:
    time.sleep(1)
