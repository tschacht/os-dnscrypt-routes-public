# Test VM settings (plan C-07). Plain KEY=VALUE lines. The environment overrides only VM_STATE_DIR;
# to override another key for a local run, export VM_ENV_<KEY> (e.g. VM_ENV_SSH_PORT=22222).
# Throw-away credentials only: this file is committed on purpose.
VM_NAME=dnscrypt-routes-test-vm
OPNSENSE_VERSION=26.7
IMAGE_URL=https://pkg.opnsense.org/releases/26.7/OPNsense-26.7-nano-amd64.img.bz2
# SHA-256 of the .bz2 download, from OPNsense-26.7-checksums-amd64.sha256
IMAGE_SHA256=28d5e2f37e40d87468a924e3006ef10e2ddc6de485b85333d9e3958c84d0cb9d
# SHA-256 of OPNsense-26.7.pub; the image signature (.sig) is verified against this pinned key
IMAGE_PUBKEY_SHA256=9f3b76ffef38fb6405595038b324b61043c9a2c375ae5c151d628508e9a845ce
PLUGINS_COMMIT=45b79b80aff277fc9edc97ce18bcd91177c40554
SSH_PORT=12222
HTTPS_PORT=14443
VNC_PORT=15900
NAT_NET=198.18.0.0/24
ROOT_PASSWORD=opnsense-test
SSH_KEY=$VM_STATE_DIR/vm_ed25519
# Guest memory (not in C-07; lower it with VM_ENV_RAM_SIZE on hosts with little memory)
RAM_SIZE=4G
# VM_STATE_DIR: unset here on purpose. Default is <main checkout>/work/vm-state; must be absolute.
